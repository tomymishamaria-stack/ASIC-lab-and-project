@file(fir_4taps.tcl) 11: set TOP_MODULE "fir_4tap"
@file(fir_4taps.tcl) 12: set RTL_FILE   "fir_4tap.v"
@file(fir_4taps.tcl) 13: set SDC_FILE   "fir_4tap.sdc"
@file(fir_4taps.tcl) 16: set WORK_DIR [pwd]
@file(fir_4taps.tcl) 22: foreach tech {45nm 90nm 180nm} {
    foreach corner {slow typical fast} {
        file mkdir "$WORK_DIR/output/$tech/$corner"
        file mkdir "$WORK_DIR/output/$tech/$corner/netlist"
        file mkdir "$WORK_DIR/output/$tech/$corner/constraints"
        file mkdir "$WORK_DIR/output/$tech/$corner/reports"
    }
}
@file(fir_4taps.tcl) 35: proc create_corner_script ...
@file(fir_4taps.tcl) 141: set LIB45  "/home/install/FOUNDRY/digital/45nm/dig/lib"
@file(fir_4taps.tcl) 142: set LIB90  "/home/install/FOUNDRY/digital/90nm/dig/lib"
@file(fir_4taps.tcl) 143: set LIB180 "/home/install/FOUNDRY/digital/180nm/RC_Libs/libraries/lib/STDCELL"
@file(fir_4taps.tcl) 145: dict set configs 45nm  path $LIB45
@file(fir_4taps.tcl) 146: dict set configs 90nm  path $LIB90
@file(fir_4taps.tcl) 147: dict set configs 180nm path $LIB180
@file(fir_4taps.tcl) 153: foreach tech {45nm 90nm 180nm} {
    set lib_path [dict get $configs $tech path]
    
    foreach corner {slow typical fast} {
        set script_file [create_corner_script $WORK_DIR $tech $corner $lib_path "${corner}.lib"]
        
        puts ""
        puts "############################################################"
        puts "# STARTING $tech [string toupper $corner]"
        puts "############################################################"

        set result [catch {
            exec genus -batch -files $script_file
        } output]

        puts $output

        if {$result != 0} {
            puts "WARNING: $tech [string toupper $corner] FAILED"
        } else {
            puts "$tech [string toupper $corner] SUCCESS"
        }
    }
}

