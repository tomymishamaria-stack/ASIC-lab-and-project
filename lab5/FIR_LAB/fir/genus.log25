@file(fir_4taps.tcl) 136: set LIB45_DIR  "/home/install/FOUNDRY/digital/45nm/dig/lib"
@file(fir_4taps.tcl) 137: set LIB90_DIR  "/home/install/FOUNDRY/digital/90nm/dig/lib"
@file(fir_4taps.tcl) 138: set LIB180_DIR "/home/install/FOUNDRY/digital/180nm/RC_Libs/libraries/lib/STDCELL"
@file(fir_4taps.tcl) 141: dict set full_libs 45nm slow    "$LIB45_DIR/slow.lib"
@file(fir_4taps.tcl) 142: dict set full_libs 45nm typical "$LIB45_DIR/typical.lib"
@file(fir_4taps.tcl) 143: dict set full_libs 45nm fast    "$LIB45_DIR/fast.lib"
@file(fir_4taps.tcl) 146: dict set full_libs 90nm slow    "$LIB90_DIR/slow.lib"
@file(fir_4taps.tcl) 147: dict set full_libs 90nm typical "$LIB90_DIR/typical.lib"
@file(fir_4taps.tcl) 148: dict set full_libs 90nm fast    "$LIB90_DIR/fast.lib"
@file(fir_4taps.tcl) 151: dict set full_libs 180nm slow    "$LIB180_DIR/slow.lib"
@file(fir_4taps.tcl) 152: dict set full_libs 180nm typical "$LIB180_DIR/tt_g_1v20_25c.lib"
@file(fir_4taps.tcl) 153: dict set full_libs 180nm fast    "$LIB180_DIR/ff_g_1v32_0c.lib"
@file(fir_4taps.tcl) 158: foreach tech {45nm 90nm 180nm} {
    foreach corner {slow typical fast} {
        set lib_file_path [dict get $full_libs $tech $corner]
        set script_file [create_corner_script $WORK_DIR $tech $corner $lib_file_path]
        set log_file "$WORK_DIR/output/$tech/$corner/logs/genus.log"

        puts ""
        puts "############################################################"
        puts "# STARTING $tech [string toupper $corner]"
        puts "############################################################"

        set result [catch {
            exec genus -batch -files $script_file -log $log_file 2>&1
        } output]

        set real_errors [check_synthesis_log $log_file]

        if {[llength $real_errors] > 0} {
            puts "WARNING: $tech [string toupper $corner] ENCOUNTERED ERRORS:"
            foreach err $real_errors {
                puts "  -> $err"
            }
        } else {
            puts "$tech [string toupper $corner] SUCCESS"
        }
    }
}

