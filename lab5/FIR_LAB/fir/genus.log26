@file(fir_4taps.tcl) 137: set LIB45_DIR  "/home/install/FOUNDRY/digital/45nm/dig/lib"
@file(fir_4taps.tcl) 138: set LIB90_DIR  "/home/install/FOUNDRY/digital/90nm/dig/lib"
@file(fir_4taps.tcl) 139: set LIB180_DIR "/home/install/FOUNDRY/digital/180nm/RC_Libs/libraries/lib/STDCELL"
@file(fir_4taps.tcl) 142: dict set lib_files 45nm slow    "slow.lib"
@file(fir_4taps.tcl) 143: dict set lib_files 45nm typical "typical.lib"
@file(fir_4taps.tcl) 144: dict set lib_files 45nm fast    "fast.lib"
@file(fir_4taps.tcl) 147: dict set lib_files 90nm slow    "slow.lib"
@file(fir_4taps.tcl) 148: dict set lib_files 90nm typical "typical.lib"
@file(fir_4taps.tcl) 149: dict set lib_files 90nm fast    "fast.lib"
@file(fir_4taps.tcl) 152: dict set lib_files 180nm slow    "slow.lib"
@file(fir_4taps.tcl) 153: dict set lib_files 180nm typical "typical.lib"
@file(fir_4taps.tcl) 154: dict set lib_files 180nm fast    "fast.lib"
@file(fir_4taps.tcl) 156: dict set lib_dirs 45nm  $LIB45_DIR
@file(fir_4taps.tcl) 157: dict set lib_dirs 90nm  $LIB90_DIR
@file(fir_4taps.tcl) 158: dict set lib_dirs 180nm $LIB180_DIR
@file(fir_4taps.tcl) 163: foreach tech {45nm 90nm 180nm} {
    set current_lib_dir [dict get $lib_dirs $tech]

    foreach corner {slow typical fast} {
        set current_lib_file [dict get $lib_files $tech $corner]
        set script_file [create_corner_script $WORK_DIR $tech $corner $current_lib_dir $current_lib_file]
        set log_file "$WORK_DIR/output/$tech/$corner/logs/genus.log"

        puts ""
        puts "############################################################"
        puts "# STARTING $tech [string toupper $corner]"
        puts "############################################################"

        set result [catch {
            exec genus -batch -files $script_file -log $log_file 2>&1
        } output]

        set real_errors [check_synthesis_log $log_file]

        if {[llength $real_errors] > 0} {
            puts "WARNING: $tech [string toupper $corner] ENCOUNTERED ERRORS:"
            foreach err $real_errors {
                puts "  -> $err"
            }
        } else {
            puts "$tech [string toupper $corner] SUCCESS"
        }
    }
}

