@file(fir_4taps.tcl) 141: set LIB45  "/home/install/FOUNDRY/digital/45nm/dig/lib"
@file(fir_4taps.tcl) 142: set LIB90  "/home/install/FOUNDRY/digital/90nm/dig/lib"
@file(fir_4taps.tcl) 143: set LIB180 "/home/install/FOUNDRY/digital/180nm/RC_Libs/libraries/lib/STDCELL"
@file(fir_4taps.tcl) 146: dict set lib_files 45nm slow    "slow.lib"
@file(fir_4taps.tcl) 147: dict set lib_files 45nm typical "typical.lib"
@file(fir_4taps.tcl) 148: dict set lib_files 45nm fast    "fast.lib"
@file(fir_4taps.tcl) 151: dict set lib_files 90nm slow    "slow.lib"
@file(fir_4taps.tcl) 152: dict set lib_files 90nm typical "typical.lib"
@file(fir_4taps.tcl) 153: dict set lib_files 90nm fast    "fast.lib"
@file(fir_4taps.tcl) 156: dict set lib_files 180nm slow    "slow.lib"
@file(fir_4taps.tcl) 157: dict set lib_files 180nm typical "tt_g_1v20_25c.lib"
@file(fir_4taps.tcl) 158: dict set lib_files 180nm fast    "ff_g_1v32_0c.lib"
@file(fir_4taps.tcl) 160: dict set configs 45nm  path $LIB45
@file(fir_4taps.tcl) 161: dict set configs 90nm  path $LIB90
@file(fir_4taps.tcl) 162: dict set configs 180nm path $LIB180
@file(fir_4taps.tcl) 167: foreach tech {45nm 90nm 180nm} {
    set lib_path [dict get $configs $tech path]

    foreach corner {slow typical fast} {
        set lib_file [dict get $lib_files $tech $corner]
        set script_file [create_corner_script $WORK_DIR $tech $corner $lib_path $lib_file]
        set log_file "$WORK_DIR/output/$tech/$corner/logs/genus.log"

        puts ""
        puts "############################################################"
        puts "# STARTING $tech [string toupper $corner]"
        puts "############################################################"

        # Redirect stderr (2>&1) to avoid false Tcl execution failures
        set result [catch {
            exec genus -batch -files $script_file -log $log_file 2>&1
        } output]

        # Scan log file for genuine synthesis errors
        set real_errors [check_synthesis_log $log_file]

        if {[llength $real_errors] > 0} {
            puts "WARNING: $tech [string toupper $corner] ENCOUNTERED ERRORS:"
            foreach err $real_errors {
                puts "  -> $err"
            }
        } else {
            puts "$tech [string toupper $corner] SUCCESS"
        }
    }
}

