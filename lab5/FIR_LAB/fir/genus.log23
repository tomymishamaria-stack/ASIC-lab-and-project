@file(fir_4taps.tcl) 8: set TOP_MODULE "fir_4tap"
@file(fir_4taps.tcl) 9: set RTL_FILE   "fir_4tap.v"
@file(fir_4taps.tcl) 10: set SDC_FILE   "fir_4tap.sdc"
@file(fir_4taps.tcl) 12: set WORK_DIR [pwd]
@file(fir_4taps.tcl) 15: foreach tech {45nm 90nm 180nm} {
    foreach corner {slow typical fast} {
        file mkdir "$WORK_DIR/output/$tech/$corner"
        file mkdir "$WORK_DIR/output/$tech/$corner/netlist"
        file mkdir "$WORK_DIR/output/$tech/$corner/constraints"
        file mkdir "$WORK_DIR/output/$tech/$corner/reports"
        file mkdir "$WORK_DIR/output/$tech/$corner/logs"
    }
}
@file(fir_4taps.tcl) 28: proc check_synthesis_log ...
@file(fir_4taps.tcl) 50: proc create_corner_script ...
@file(fir_4taps.tcl) 140: set LIB45  "/home/install/FOUNDRY/digital/45nm/dig/lib"
@file(fir_4taps.tcl) 141: set LIB90  "/home/install/FOUNDRY/digital/90nm/dig/lib"
@file(fir_4taps.tcl) 142: set LIB180 "/home/install/FOUNDRY/digital/180nm/RC_Libs/libraries/lib/STDCELL"
@file(fir_4taps.tcl) 144: dict set configs 45nm  path $LIB45
@file(fir_4taps.tcl) 145: dict set configs 90nm  path $LIB90
@file(fir_4taps.tcl) 146: dict set configs 180nm path $LIB180
@file(fir_4taps.tcl) 151: foreach tech {45nm 90nm 180nm} {
    set lib_path [dict get $configs $tech path]

    foreach corner {slow typical fast} {
        set script_file [create_corner_script $WORK_DIR $tech $corner $lib_path "${corner}.lib"]
        set log_file "$WORK_DIR/output/$tech/$corner/logs/genus.log"

        puts ""
        puts "############################################################"
        puts "# STARTING $tech [string toupper $corner]"
        puts "############################################################"

        # Redirect stderr with 2>&1 to prevent false 'FAILED' warnings
        set result [catch {
            exec genus -batch -files $script_file -log $log_file 2>&1
        } output]

        # Scan generated log file for actual synthesis errors
        set real_errors [check_synthesis_log $log_file]

        if {[llength $real_errors] > 0} {
            puts "WARNING: $tech [string toupper $corner] ENCOUNTERED ERRORS:"
            foreach err $real_errors {
                puts "  -> $err"
            }
        } else {
            puts "$tech [string toupper $corner] SUCCESS"
        }
    }
}

