@file(run_vcd_reports.tcl) 19: puts "INFO: Starting Individual Module VCD Power Analysis Flow..."
INFO: Starting Individual Module VCD Power Analysis Flow...
@file(run_vcd_reports.tcl) 20: puts "--------------------------------------------------------------------"
--------------------------------------------------------------------
@file(run_vcd_reports.tcl) 22: foreach vcd_file [glob -nocomplain "$VCD_DIR/tb_*.vcd"] {
    set mod_name [file rootname [file tail $vcd_file]]
    
    # Skip tb_top since it's the full system
    if {$mod_name eq "tb_top"} continue
    
    # Derive the DUT instance name (e.g., tb_idle_counter -> /tb_idle_counter/dut)
    set inst_name "/${mod_name}/dut"
    
    puts "\nProcessing: $mod_name -> Target Instance: $inst_name"
    
    # Read VCD with explicit DUT instance mapping
    if {[catch {read_vcd -dut_instance $inst_name $vcd_file} err]} {
        puts "WARNING: Could not auto-map $inst_name for $mod_name. Trying default read..."
        if {[catch {read_vcd $vcd_file} err2]} {
            puts "ERROR: Failed to read $vcd_file. Reason: $err2"
            continue
        }
    }

    set report_file "output/reports/${mod_name}_vcd_power.rpt"
    
    if {[catch {report_power > $report_file} err]} {
        puts "ERROR: Power reporting failed for $mod_name. Reason: $err"
        continue
    }
    
    puts "--> Successfully generated unique report: $report_file"
}

