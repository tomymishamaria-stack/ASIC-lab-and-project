@file(run_vcd_reports.tcl) 45: foreach mod $sub_modules {
    set report_file "output/reports/${mod}_vcd_power.rpt"
    
    # Target each specific instance using the correct -inst flag
    if {[catch {report_power -inst $mod > $report_file} err]} {
        puts "WARNING: Could not generate report for instance '$mod': $err"
    } else {
        puts "--> Generated unique report: $report_file"
    }
}
