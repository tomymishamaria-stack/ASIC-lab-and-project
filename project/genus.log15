INFO: Starting Individual Module VCD Power Analysis Flow...
@file(run_vcd_reports.tcl) 20: puts "--------------------------------------------------------------------"
--------------------------------------------------------------------
@file(run_vcd_reports.tcl) 23: foreach vcd_file [glob -nocomplain "$VCD_DIR/tb_*.vcd"] {
    set mod_name [file rootname [file tail $vcd_file]]
    
    # Skip tb_top for this specific loop
    if {$mod_name eq "tb_top"} continue
    
    puts "\nProcessing VCD: $vcd_file"

    # Read the VCD file (using standard static analysis mode)
    if {[catch {read_vcd -static $vcd_file} err]} {
        puts "ERROR: Failed to read $vcd_file. Reason: $err"
        continue
    }

    set report_file "output/reports/${mod_name}_vcd_power.rpt"
    
    # Generate the power report for the current activity state
    if {[catch {report_power > $report_file} err]} {
        puts "ERROR: Power reporting failed for $mod_name. Reason: $err"
        continue
    }
    
    puts "--> Successfully generated unique report: $report_file"
}

