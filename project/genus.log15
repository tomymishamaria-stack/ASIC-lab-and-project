@file(run_vcd_reports.tcl) 49: if {[file exists "$VCD_DIR/tb_top.vcd"]} {
    puts "\nProcessing Top-Level System VCD..."
    read_vcd -static "$VCD_DIR/tb_top.vcd"
    report_power > "output/reports/tb_top_vcd_power.rpt"
    puts "--> Successfully generated top-level report: output/reports/tb_top_vcd_power.rpt"
}

