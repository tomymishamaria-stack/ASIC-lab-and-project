# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line
create_library_set -name max_timing -timing {../../../../install/FOUNDRY/digital/90nm/dig/lib/slow.lib}
create_library_set -name min_timing -timing {../../../../install/FOUNDRY/digital/90nm/dig/lib/fast.lib}
create_constraint_mode -name alu_constraint -sdc_files {output/constraints/alu_expr_synth.sdc}
create_delay_corner -name max_delay -library_set {max_timing}
create_delay_corner -name min_delay -library_set {min_timing}
create_analysis_view -name worst_case -constraint_mode {alu_constraint} -delay_corner {max_delay}
create_analysis_view -name best_case -constraint_mode {alu_constraint} -delay_corner {min_delay}
set_analysis_view -setup {worst_case} -hold {best_case}
